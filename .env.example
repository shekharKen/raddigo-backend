# Application configuration
# Copy to .env and adjust as needed.

# HTTP server listen address
SERVER_ADDR=:8080

# Timeouts (Go duration format, e.g. 5s, 1m)
READ_TIMEOUT=10s
WRITE_TIMEOUT=10s
IDLE_TIMEOUT=60s
SHUTDOWN_TIMEOUT=10s

# PostgreSQL connection string
DATABASE_URL=postgres://postgres:postgres@localhost:5432/raddigo?sslmode=disable

# Public base URL used to build absolute URLs for uploaded assets (e.g. profile images)
APP_BASE_URL=http://localhost:8080

# Duration of each bookable partner time slot (Go duration format, e.g. 15m, 30m, 1h)
SLOT_DURATION=30m

# Fixed OTP used for account email verification and password-reset requests
# instead of a random 6-digit code, so you don't need to check the
# logs/mailer during local development.
# Leave empty (or unset) to always generate a random OTP, as in production.
DEV_OTP=

SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USERNAME=your-username
SMTP_PASSWORD=your-password
SMTP_FROM_ADDRESS=no-reply@raddigo.com
SMTP_FROM_NAME=Raddigo
